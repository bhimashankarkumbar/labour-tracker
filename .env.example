# ===================================
# Labour Tracker - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ===================================

# ---- MySQL Database ----
DB_URL=jdbc:mysql://localhost:3306/labour_tracker?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ---- JWT ----
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_at_least_64_characters_long
JWT_EXPIRATION_MS=86400000

# ---- Server ----
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=dev
